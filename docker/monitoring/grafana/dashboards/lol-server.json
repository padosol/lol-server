        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "id": 32,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "JVM Thread States",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_threads_states_threads{application=\"lol-server\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 },
      "id": 104,
      "title": "Tomcat",
      "type": "row"
    },
