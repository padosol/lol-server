# ===========================================
# LOL Server - Local 개발 환경 변수
# ===========================================
# 사용법: 이 파일을 .env로 복사 후 값을 수정하세요
#   cp .env.example .env
# ===========================================

# --- Riot Games API ---
RIOT_API_KEY=your-riot-api-key-here

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=1234

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=clickhouse

# --- Spring ---
SPRING_PROFILES_ACTIVE=local

# --- OAuth 공통 ---
# Spring Security 의 콜백 엔드포인트가 붙는 베이스. 프론트가 아니라 이 서버다.
# 비워 두면 api-local.yml 의 기본값(http://localhost:8100)이 쓰인다.
OAUTH_REDIRECT_BASE_URL=http://localhost:8100

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- BigQuery ---
# 통계 데이터소스 토글: clickhouse(기본) | bigquery
# bigquery로 두지 않으면 아래 BIGQUERY_* 변수는 무시됩니다
STATS_DATASOURCE=clickhouse
# STATS_DATASOURCE=bigquery 일 때만 필수
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=lol_analytics
# 인증 (둘 중 하나만 사용; 둘 다 비우면 ADC: gcloud auth application-default login 또는 GCP 워크로드 ID)
# 1) Service Account JSON 경로 - Spring Resource 표기 (file:/..., classpath:..., http://...)
BIGQUERY_CREDENTIALS_LOCATION=
# 2) Google ADC 표준 환경변수 (BIGQUERY_CREDENTIALS_LOCATION 비어있을 때 자동 사용)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json


# --- Riot RSO OAuth ---
RIOT_RSO_CLIENT_ID=your-riot-rso-client-id
RIOT_RSO_CLIENT_SECRET=your-riot-rso-client-secret

# --- Champion Stats Cache ---
CHAMPION_STATS_CACHE_ENABLED=true

# --- AWS S3 / CloudFront (커뮤니티 이미지 업로드) ---
# 로컬도 운영과 같은 코드 경로로 실제 S3 를 쓴다. 격리는 버킷이 한다.
# 아래 세 값은 api-local.yml 에 같은 기본값이 있으므로 그대로 쓸 거면 비워 둬도 된다.
S3_BUCKET=mmrtr-community-dev
AWS_REGION=ap-northeast-2
# CloudFront 배포는 게임 정적 자산과 공유하고 경로로 갈린다
# (로컬 키는 community-dev/ 아래, 운영은 community/ 아래).
CDN_BASE_URL=https://static.metapick.me
#
# 크리덴셜은 코드가 아니라 DefaultCredentialsProvider 체인이 해석한다.
# ~/.aws/credentials 프로필이 있으면 아래 두 줄은 손대지 않아도 된다.
# 이 버킷에 대한 PutObject/GetObject/DeleteObject 권한이 필요하다.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# --- JWT ---
JWT_SECRET_KEY=local-dev-secret-key-must-be-at-least-256-bits-long-for-hs256
